    "EMAIL;TYPE=WORK,INTERNET:info@andreaoliva.eu",
    "ADR;TYPE=WORK:;;Via di Cavana 15;Trieste;TS;34124;Italy",
    "URL:https://www.andreaoliva.eu/",
    "NOTE:REA TS-130420 - VAT 01177510326 - PEC andreaoliva@legalmail.it - Mobile is also on WhatsApp",
    "END:VCARD"
  ].join("\r\n") + "\r\n";

  var link = document.getElementById("save-contact");
  var fileName = "Andrea-Oliva-Partners.vcf";

  // Fallback: data: URI with the download attribute (used if the Blob route fails)
  link.setAttribute("href", "data:text/vcard;charset=utf-8," + encodeURIComponent(vcard));
  link.setAttribute("download", fileName);

  link.addEventListener("click", function (event) {
    try {
      var blob = new Blob([vcard], { type: "text/vcard;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
      event.preventDefault();
    } catch (e) {
      // Blob failed: let the browser follow the data: URI link instead
    }
  });
})();
</script>

