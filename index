<script>
(function () {
  // vCard 3.0 – edit the values below to change the contact card.
  // Lines are joined with CRLF; commas and semicolons inside values must be escaped with a backslash.
  var vcard = [
    "BEGIN:VCARD",
    "VERSION:3.0",
    "N:Oliva;Andrea;;;",
    "FN:Andrea Oliva",
    "ORG:Andrea Oliva & Partners S.r.l.",
    "TITLE:Sole Director",
    "TEL;TYPE=WORK,VOICE:+39 0403229321",
